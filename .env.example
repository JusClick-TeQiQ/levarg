# ── AI Backend (choose one) ──────────────────────────────────────────
# Option 1: Cloudflare Workers AI (recommended — free, no local install)
#   Get your token at: https://dash.cloudflare.com/profile/api-tokens
#   Create Custom Token → Permission: Account / Workers AI / Edit
CF_AI_TOKEN=""
CF_ACCOUNT_ID=""
# CF_AI_MODEL="@cf/meta/llama-3.1-8b-instruct"

# Option 2: Remote Ollama (run on a separate machine, not locally)
# OLLAMA_URL="http://your-server:11434"
# OLLAMA_MODEL="llama3.2"

# ── App Configuration ────────────────────────────────────────────────
# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# LEVARG_BIND: Network interface to bind to (default: 127.0.0.1)
# Set to 0.0.0.0 for LAN access (requires LEVARG_API_KEY for security)
LEVARG_BIND="127.0.0.1"

# LEVARG_PORT: Port to listen on (default: 3000)
LEVARG_PORT="3000"

# LEVARG_API_KEY: Optional API key for non-localhost access.
# When set, all /api/* requests from non-localhost IPs must include
# the X-Api-Key header or ?apiKey= query parameter.
# LEVARG_API_KEY=""

# LEVARG_CORS_ORIGINS: Comma-separated list of allowed CORS origins.
# Defaults to http://localhost:PORT and http://127.0.0.1:PORT
# LEVARG_CORS_ORIGINS="http://localhost:3000,http://192.168.1.100:3000"
